{
  "name": "mysql-routine-debugger",
  "displayName": "MySQL Routine Debugger",
  "description": "Debug MySQL and MariaDB stored procedures and functions with breakpoints, stepping, watches, and execution logs.",
  "version": "0.1.2",
  "publisher": "rk22",
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/rk22-projects/mysql-routine-debugger.git"
  },
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": ["Debuggers", "Other"],
  "keywords": ["mariadb", "mysql", "stored procedure", "debugger"],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:mysqlRoutineDebugger.open",
    "onCommand:mysqlRoutineDebugger.connect"
  ],
  "main": "./extension.js",
  "scripts": {
    "check": "node --check extension.js",
    "package": "npx --yes @vscode/vsce package --no-dependencies"
  },
  "contributes": {
    "commands": [
      { "command": "mysqlRoutineDebugger.open", "title": "MySQL Routine Debugger: Open Debugger", "icon": "$(debug-console)" },
      { "command": "mysqlRoutineDebugger.connect", "title": "MySQL Routine Debugger: Connect", "icon": "$(plug)" },
      { "command": "mysqlRoutineDebugger.refresh", "title": "MySQL Routine Debugger: Refresh Routines", "icon": "$(refresh)" },
      { "command": "mysqlRoutineDebugger.load", "title": "MySQL Routine Debugger: Open Routine" },
      { "command": "mysqlRoutineDebugger.deploy", "title": "MySQL Routine Debugger: Start Debugging", "icon": "$(debug-start)" },
      { "command": "mysqlRoutineDebugger.stop", "title": "MySQL Routine Debugger: Stop Debugging", "icon": "$(debug-stop)" },
      { "command": "mysqlRoutineDebugger.continue", "title": "MySQL Routine Debugger: Continue", "icon": "$(debug-continue)" },
      { "command": "mysqlRoutineDebugger.stepInto", "title": "MySQL Routine Debugger: Step Into", "icon": "$(debug-step-into)" },
      { "command": "mysqlRoutineDebugger.stepOut", "title": "MySQL Routine Debugger: Step Out", "icon": "$(debug-step-out)" },
      { "command": "mysqlRoutineDebugger.step", "title": "MySQL Routine Debugger: Step Over", "icon": "$(debug-step-over)" },
      { "command": "mysqlRoutineDebugger.toggleBreakpoint", "title": "MySQL Routine Debugger: Toggle Breakpoint" },
      { "command": "mysqlRoutineDebugger.addWatch", "title": "MySQL Routine Debugger: Add Watch", "icon": "$(add)" },
      { "command": "mysqlRoutineDebugger.removeWatch", "title": "MySQL Routine Debugger: Remove Watch" },
      { "command": "mysqlRoutineDebugger.clearLog", "title": "MySQL Routine Debugger: Clear Log", "icon": "$(clear-all)" },
      { "command": "mysqlRoutineDebugger.reset", "title": "MySQL Routine Debugger: Reset All Debug Changes" }
    ],
    "menus": {
      "commandPalette": [
        { "command": "mysqlRoutineDebugger.continue", "when": "mysqlRoutineDebugger.paused" },
        { "command": "mysqlRoutineDebugger.stepInto", "when": "mysqlRoutineDebugger.paused" },
        { "command": "mysqlRoutineDebugger.stepOut", "when": "mysqlRoutineDebugger.paused" },
        { "command": "mysqlRoutineDebugger.step", "when": "mysqlRoutineDebugger.paused" }
      ]
    },
    "keybindings": [
      { "command": "mysqlRoutineDebugger.continue", "key": "f5", "when": "mysqlRoutineDebugger.paused" },
      { "command": "mysqlRoutineDebugger.stepInto", "key": "f7", "when": "mysqlRoutineDebugger.paused" },
      { "command": "mysqlRoutineDebugger.stepOut", "key": "ctrl+f7", "when": "mysqlRoutineDebugger.paused" },
      { "command": "mysqlRoutineDebugger.step", "key": "f8", "when": "mysqlRoutineDebugger.paused" },
      { "command": "mysqlRoutineDebugger.toggleBreakpoint", "key": "f9", "when": "activeWebviewPanelId == mysqlRoutineDebugger.panel" }
    ],
    "configuration": {
      "title": "MySQL Routine Debugger",
      "properties": {
        "mysqlRoutineDebugger.host": { "type": "string", "default": "localhost", "description": "Database server hostname." },
        "mysqlRoutineDebugger.port": { "type": "number", "default": 3306, "description": "Database server port." },
        "mysqlRoutineDebugger.user": { "type": "string", "default": "", "description": "Database user. Passwords are kept in VS Code secret storage." },
        "mysqlRoutineDebugger.database": { "type": "string", "default": "", "description": "Database/schema containing the routines." },
        "mysqlRoutineDebugger.javaPath": { "type": "string", "default": "java", "description": "Optional Java 17+ executable override. The extension automatically discovers Java by default." },
        "mysqlRoutineDebugger.pollInterval": { "type": "number", "default": 600, "minimum": 200, "description": "Debug-state polling interval in milliseconds." }
      }
    }
  }
}
